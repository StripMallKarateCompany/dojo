#!/usr/bin/env bash
# Boots Dojo on x86_64 from Dojo's own karate packages, either live from the
# karate/linux kernel and an initramfs or from a disk doj-install wrote. QEMU
# emulates the machine (TCG), so this runs on any Mac or Linux host with Nix and
# proves nothing about hardware.
#
# <pkgs> is a copy of a builder's /doj/pkgs/karate. The live image is busybox-static,
# doj-launch, doj-sup-static and doj in /bin, as the arm64 VM has them, the arm64 VM's
# init, check and lease, doj-install, doj-write-image, and every package in <pkgs> under
# /doj/pkgs for doj-install to copy. The newest release of each package is used.
#
#   --check                  boot with dojo.check; succeed only on "dojo: check ok"
#   --install <args>         run doj-install <args> from the live image, then power off;
#                            succeed only on "dojo: install ok"
#   --refuse-install <args>  the same, succeeding only on "dojo: install failed"
#   --file <host>:<guest>    put a file into the live image (an install's key file)
#   --write-image <image>    write the live image to <image> as a disk image that boots
#                            through BIOS and UEFI (a USB stick's contents) instead of
#                            booting it; --check and --install apply to that image's boots
#   --disk <image>           attach a raw disk image as /dev/vda
#   --usb <image>            attach a raw disk image as a USB stick
#   --from-disk              boot the USB stick, or else the disk, instead of the live image
#   --uefi                   boot through QEMU's EDK II UEFI firmware instead of SeaBIOS
#   --console <port>         serial console on 127.0.0.1:<port> instead of the log
#   --ssh-port <port>        forward 127.0.0.1:<port> to the guest's port 22
#   --log <file>             where the serial console goes (default: a temporary file)
#   --timeout <seconds>      QEMU's deadline (default 600)
set -euo pipefail

usage() {
  echo "usage: support/vm/x86_64/boot <pkgs> [--check | --install <args> | --refuse-install <args>]" \
    "[--file <host>:<guest>]... [--write-image <image>] [--disk <image>] [--usb <image>] [--from-disk] [--uefi] [--console <port>] [--ssh-port <port>]" \
    "[--log <file>] [--timeout <seconds>]" >&2
  exit 2
}
[[ $# -ge 1 ]] || usage
pkgs="$1"
shift
mode=interactive
install_args=""
files=()
write_image=""
disk=""
usb=""
from_disk=false
uefi=false
console=""
ssh_port=""
log=""
deadline=600
while [[ $# -gt 0 ]]; do
  case "$1" in
  --check)
    mode=check
    shift
    ;;
  --install | --refuse-install)
    [[ $# -ge 2 ]] || usage
    mode="${1#--}"
    install_args="$2"
    shift 2
    ;;
  --file)
    [[ $# -ge 2 && "$2" == *:/* ]] || usage
    files+=("$2")
    shift 2
    ;;
  --write-image)
    [[ $# -ge 2 ]] || usage
    write_image="$2"
    shift 2
    ;;
  --disk)
    [[ $# -ge 2 ]] || usage
    disk="$2"
    shift 2
    ;;
  --usb)
    [[ $# -ge 2 ]] || usage
    usb="$2"
    shift 2
    ;;
  --from-disk)
    from_disk=true
    shift
    ;;
  --uefi)
    uefi=true
    shift
    ;;
  --console)
    [[ $# -ge 2 ]] || usage
    console="$2"
    shift 2
    ;;
  --ssh-port)
    [[ $# -ge 2 ]] || usage
    ssh_port="$2"
    shift 2
    ;;
  --log)
    [[ $# -ge 2 ]] || usage
    log="$2"
    shift 2
    ;;
  --timeout)
    [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || usage
    deadline="$2"
    shift 2
    ;;
  *) usage ;;
  esac
done
[[ -d "${pkgs}" ]] || {
  echo "boot: no package directory at ${pkgs}" >&2
  exit 2
}
if "${from_disk}" && [[ -z "${disk}" && -z "${usb}" ]]; then
  echo "boot: --from-disk needs --disk or --usb" >&2
  exit 2
fi
if [[ -n "${write_image}" ]] && { [[ -n "${disk}" || -n "${usb}" ]] || "${from_disk}" || "${uefi}"; }; then
  echo "boot: --write-image boots the live image with nothing else attached" >&2
  exit 2
fi
if [[ -n "${write_image}" && "${mode}" == refuse-install ]]; then
  echo "boot: --write-image takes --install, not --refuse-install" >&2
  exit 2
fi
if "${from_disk}" && [[ "${mode}" == *install ]]; then
  echo "boot: an install runs from the live image, not --from-disk" >&2
  exit 2
fi
for attached in "${disk}" "${usb}"; do
  if [[ -n "${attached}" && ! -f "${attached}" ]]; then
    echo "boot: no disk image at ${attached}" >&2
    exit 2
  fi
done

vm="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
{
  read -r qemu
  read -r coreutils
  read -r cpio
} < <(nix-build --no-out-link "${vm}" -A qemu -A coreutils -A cpio)
firmware="${qemu}/share/qemu/edk2-x86_64-code.fd"
qemu="${qemu}/bin/qemu-system-x86_64"

work="$(mktemp -d "${TMPDIR:-/tmp}/dojo-vm-x86_64.XXXXXX")"
trap 'chmod -R u+w "${work}"; rm -rf "${work}"' EXIT

args=(-machine q35 -accel tcg -cpu max -smp 2 -m 3072 -no-reboot)
# QEMU options are comma lists inside one word.
# shellcheck disable=SC2054
netdev=user,id=net0
if [[ -n "${ssh_port}" ]]; then
  netdev+=",hostfwd=tcp:127.0.0.1:${ssh_port}-:22"
fi
# shellcheck disable=SC2054
args+=(-netdev "${netdev}" -device virtio-net-pci,netdev=net0)
# --from-disk boots the device with bootindex=0: the USB stick when there is one.
# A live boot leaves it to -kernel, whose loader takes bootindex 0 itself.
disk_boot="" usb_boot=""
if "${from_disk}" && [[ -n "${usb}" ]]; then
  usb_boot=",bootindex=0"
elif "${from_disk}"; then
  disk_boot=",bootindex=0"
fi
# shellcheck disable=SC2054
if [[ -n "${disk}" ]]; then
  args+=(-drive "file=${disk},format=raw,if=none,id=disk0" -device "virtio-blk-pci,drive=disk0${disk_boot}")
fi
# shellcheck disable=SC2054
if [[ -n "${usb}" ]]; then
  args+=(-device qemu-xhci,id=xhci -drive "file=${usb},format=raw,if=none,id=stick"
    -device "usb-storage,bus=xhci.0,drive=stick,removable=on${usb_boot}")
fi
if "${uefi}"; then
  # The firmware's variables are not kept: doj-install boots UEFI from the removable
  # media path, without a boot entry.
  args+=(-drive "if=pflash,format=raw,readonly=on,file=${firmware}")
fi

if ! "${from_disk}"; then
  # The newest release of a package: <pkgs>/<name>/<version>/<release>.
  newest() {
    local release
    release="$(printf '%s\n' "${pkgs}/$1"/*/* | sort | tail -n 1)"
    [[ -d "${release}" ]] || {
      echo "boot: no karate/$1 in ${pkgs}" >&2
      exit 1
    }
    echo "${release}"
  }
  kernel="$(newest linux)/boot/bzImage"
  root="${work}/root"
  mkdir -p "${root}"/{bin,root,dev,proc,sys,run,tmp,etc,doj/pkgs}
  cp "$(newest busybox-static)/bin/busybox" "${root}/bin/busybox"
  while read -r applet; do
    ln -s busybox "${root}/bin/${applet}"
  done <"${vm}/applets"
  cp "$(newest doj-launcher)/bin/doj-launch" "$(newest doj-sup-static)/bin/doj-sup" \
    "$(newest doj)/bin/doj" "${root}/bin/"
  cp "${vm}/init" "${root}/init"
  cp "${vm}/check" "${root}/bin/check"
  cp "${vm}/lease" "${root}/bin/lease"
  cp "${vm}/../install/doj-install" "${vm}/../install/doj-write-image" "${root}/bin/"
  chmod 0755 "${root}/init" "${root}"/bin/{check,lease,busybox,doj-launch,doj-sup,doj,doj-install,doj-write-image}
  echo "root:x:0:0:root:/root:/bin/sh" >"${root}/etc/passwd"
  echo "root:x:0:" >"${root}/etc/group"
  cp -R "${pkgs}" "${root}/doj/pkgs/karate"
  for f in "${files[@]+"${files[@]}"}"; do
    mkdir -p "${root}/$(dirname "${f#*:}")"
    cp "${f%%:*}" "${root}/${f#*:}"
  done
  mode_args=""
  case "${mode}" in
  check) mode_args="dojo.check" ;;
  install | refuse-install)
    echo "${install_args}" >"${root}/etc/doj-install.args"
    mode_args="dojo.install"
    ;;
  esac
  if [[ -n "${write_image}" ]]; then
    echo "${mode_args}" >"${root}/etc/doj-image.args"
  fi
  initrd="${work}/initrd.cpio.gz"
  (cd "${root}" && find . | "${cpio}/bin/cpio" --quiet -o -H newc -R 0:0) | gzip -6 >"${initrd}"
  append="console=ttyS0 panic=-1"
  if [[ -n "${write_image}" ]]; then
    # The guest reads the initramfs from a disk, in whole sectors: pad it with zeros,
    # which the kernel skips after a compressed archive.
    "${coreutils}/bin/truncate" -s %512 "${initrd}"
    initrd_bytes="$(wc -c <"${initrd}" | tr -d ' ')"
    kernel_bytes="$(wc -c <"${kernel}" | tr -d ' ')"
    # The EFI system partition holds the kernel, the initramfs and grub's two
    # platforms (about 15 MiB), with room for FAT32's tables; 1 MiB more for the
    # BIOS boot partition and GPT's two copies.
    image_mib=$(((initrd_bytes + kernel_bytes) / 1048576 + 64))
    image="${work}/live.img"
    "${coreutils}/bin/truncate" -s "${image_mib}M" "${image}"
    # shellcheck disable=SC2054
    args+=(-drive "file=${initrd},format=raw,if=none,id=initrd,readonly=on"
      -device virtio-blk-pci,drive=initrd,serial=dojo-initrd
      -drive "file=${image},format=raw,if=none,id=image"
      -device virtio-blk-pci,drive=image,serial=dojo-image)
    append+=" dojo.image=${initrd_bytes}"
  else
    append+=" ${mode_args}"
  fi
  args+=(-kernel "${kernel}" -initrd "${initrd}" -append "${append}")
fi

if [[ -n "${console}" ]]; then
  # A driver logs in on the serial console; the log is what QEMU itself says.
  args+=(-display none -monitor none -serial "tcp:127.0.0.1:${console},server=on,wait=off")
else
  args+=(-nographic)
fi

log="${log:-${work}/console.log}"
status=0
"${coreutils}/bin/timeout" "${deadline}" "${qemu}" "${args[@]}" </dev/null >"${log}" 2>&1 || status=$?
if [[ "${status}" -ne 0 ]]; then
  echo "boot: QEMU exited ${status} (124 is the ${deadline} second deadline)" >&2
  exit 1
fi
expect=""
case "${mode}" in
check) expect="dojo: check ok" ;;
install) expect="dojo: install ok" ;;
refuse-install) expect="dojo: install failed" ;;
esac
if [[ -n "${write_image}" ]]; then
  expect="dojo: image ok"
fi
if [[ -n "${expect}" ]] && ! grep -q "${expect}" "${log}"; then
  echo "boot: the VM shut down without \"${expect}\"" >&2
  exit 1
fi
if [[ -z "${console}" ]]; then
  if grep -q 'IP Address lookup failed' "${log}"; then
    echo "boot: the Supervisor did not find its own address" >&2
    exit 1
  fi
  if grep -q 'Kernel panic' "${log}" || ! grep -q 'reboot: Power down' "${log}"; then
    echo "boot: the VM did not end cleanly (expected \"reboot: Power down\")" >&2
    exit 1
  fi
fi
if [[ -n "${write_image}" ]]; then
  mv "${image}" "${write_image}"
  echo "boot: wrote ${write_image}"
fi
