#!/usr/bin/env bash
# Runs nixpkgs' Linux builder, an arm64 NixOS VM under Apple's hypervisor, and
# builds and tests this tree in it.
#
#   builder start                  start the VM and wait for ssh
#   builder stop                   stop it
#   builder ssh [command...]       a shell or a command in the VM
#   builder payload [--update-lock]
#                                  build doj-launch, doj-sup and doj into
#                                  support/vm/out/payload.cpio.gz for boot --payload;
#                                  --update-lock lets cargo change Cargo.lock and
#                                  copies it back
#   builder test <package>...      test packages and check their formatting
#   builder run <command>...       run a command in the tree's build environment
#                                  in the VM; copies Cargo.lock back if it changed
#   builder fmt <package>...       format packages with the tree's nightly
#                                  rustfmt and copy back the files it rewrote
#   builder verify                 the checks a pull request carries: every test
#                                  against support/vm/expected-failures, the
#                                  payload, and boot --check and --check-reboot
#   builder discard <tree> [--stop]
#                                  delete a tree's VM state; refuses while that
#                                  VM runs, unless --stop stops it first
#
# Each command but ssh copies this tree over the VM's ~/dojo first, so a file
# the VM changed and no command copied back is gone at the next one.
#
# The VM's disk, ssh key and log live in DOJO_BUILDER_STATE, and its ssh port,
# DOJO_BUILDER_PORT, listens on localhost only. Each tree (trees add) has a VM
# of its own by default: ~/.local/state/dojo-builder-<tree> on a port derived
# from the tree's name, which .trees.d/pre-remove discards with the tree. The
# main checkout's is ~/.local/state/dojo-builder on 31022.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo="$(cd "${here}/../.." && pwd)"
state_root="${XDG_STATE_HOME:-${HOME}/.local/state}"

usage() {
  sed -n '5,32p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

# A tree's VM state: one place names it, for this script's default and for
# discard, which the main checkout's copy runs for a tree being removed.
tree_state() {
  printf '%s/dojo-builder-%s\n' "${state_root}" "$1"
}

# A port in 31100-31899 from the tree's name, so parallel trees' VMs do not
# collide by default. Two names can still land on one port; the second VM then
# fails to forward it and start says the VM exited.
tree_port() {
  local sum
  sum="$(printf '%s' "$1" | cksum)"
  printf '%d\n' "$((31100 + ${sum%% *} % 800))"
}

# The tree this script runs from, or nothing in the main checkout: a linked
# worktree's git dir is not the common one.
this_tree() {
  local dirs
  dirs="$(git -C "${repo}" rev-parse --path-format=absolute --git-dir --git-common-dir 2>/dev/null)" || return 0
  local git_dir="${dirs%%$'\n'*}" common_dir="${dirs#*$'\n'}"
  if [[ "${git_dir}" != "${common_dir}" ]]; then
    basename "${repo}"
  fi
}

tree="$(this_tree)"
if [[ -n "${tree}" ]]; then
  state="${DOJO_BUILDER_STATE:-$(tree_state "${tree}")}"
  port="${DOJO_BUILDER_PORT:-$(tree_port "${tree}")}"
else
  state="${DOJO_BUILDER_STATE:-${state_root}/dojo-builder}"
  port="${DOJO_BUILDER_PORT:-31022}"
fi

vm_ssh() {
  ssh -F "${state}/ssh_config" dojo-builder "$@"
}

running() {
  [[ -f "${state}/pid" ]] && kill -0 "$(cat "${state}/pid")" 2>/dev/null
}

start() {
  if running; then
    echo "builder: already running (pid $(cat "${state}/pid"))" >&2
    return 0
  fi
  mkdir -p "${state}/key"
  if [[ ! -f "${state}/key/builder_ed25519" ]]; then
    ssh-keygen -q -t ed25519 -N "" -C builder@dojo -f "${state}/key/builder_ed25519"
  fi
  # The VM's sshd reads the public key from a mounted directory and, with
  # StrictModes, wants it owned by root: a store path is.
  mkdir -p "${state}/authorized"
  cp "${state}/key/builder_ed25519.pub" "${state}/authorized/builder_ed25519.pub"
  local keys
  keys="$(nix-store --add "${state}/authorized")"
  cat >"${state}/ssh_config" <<CONFIG
Host dojo-builder
  HostName 127.0.0.1
  Port ${port}
  User builder
  IdentityFile ${state}/key/builder_ed25519
  IdentitiesOnly yes
  BatchMode yes
  StrictHostKeyChecking accept-new
  UserKnownHostsFile ${state}/known_hosts
  ConnectTimeout 5
CONFIG
  rm -f "${state}/known_hosts"

  # nixpkgs' start script, with four changes: hardware virtualization only (no
  # emulation fallback), 8 CPUs (GICv2's limit) and 32 GB, ssh on localhost
  # only, and a 120 GB disk for Rust builds.
  local vm
  vm="$(nix-build --no-out-link "${here}" -A builder)"
  local script="${state}/run-builder"
  cp "${vm}/bin/run-nixos-vm" "${script}"
  chmod u+w "${script}"
  local edits=(
    's/accel=hvf:tcg/accel=hvf/'
    's/-m 3072 /-m 32768 /'
    's/-smp 1 /-smp 8 /'
    "s/hostfwd=tcp::31022-:22/hostfwd=tcp:127.0.0.1:${port}-:22/"
    's/"20480M"/"122880M"/'
  )
  local edit
  for edit in "${edits[@]}"; do
    local before
    before="$(cat "${script}")"
    sed -i.bak "${edit}" "${script}"
    if [[ "$(cat "${script}")" == "${before}" ]]; then
      echo "builder: nixpkgs' start script changed; this edit no longer applies: ${edit}" >&2
      exit 1
    fi
  done
  rm -f "${script}.bak"

  (
    cd "${state}"
    KEYS="${keys}" NIX_DISK_IMAGE="${state}/nixos.qcow2" nohup "${script}" </dev/null >"${state}/console.log" 2>&1 &
    echo $! >"${state}/pid"
  )
  local _
  for _ in $(seq 1 60); do
    if vm_ssh true 2>/dev/null; then
      echo "builder: running (pid $(cat "${state}/pid")); console log ${state}/console.log" >&2
      return 0
    fi
    if ! running; then
      echo "builder: the VM exited; see ${state}/console.log" >&2
      exit 1
    fi
    sleep 3
  done
  echo "builder: no ssh after 180 seconds; see ${state}/console.log" >&2
  exit 1
}

stop() {
  if ! running; then
    echo "builder: not running (${state}, port ${port})" >&2
    return 0
  fi
  local pid
  pid="$(cat "${state}/pid")"
  vm_ssh sudo -n poweroff 2>/dev/null || kill "${pid}"
  local _
  for _ in $(seq 1 30); do
    if ! kill -0 "${pid}" 2>/dev/null; then
      rm -f "${state}/pid"
      return 0
    fi
    sleep 1
  done
  kill -9 "${pid}"
  rm -f "${state}/pid"
}

require_running() {
  if ! running; then
    echo "builder: not running (${state}, port ${port}); start it with support/vm/builder start" >&2
    exit 1
  fi
}

# Copies the tree's tracked and unignored files into a fresh ~/dojo in the VM,
# keeping the old tree's target directory so builds stay incremental. The old
# tree is replaced only once the new one has arrived whole: an empty or broken
# copy fails here and leaves it as it was.
sync_tree() {
  # Apple's tar, whatever a dev shell puts first on PATH: GNU tar has no
  # --no-mac-metadata.
  (cd "${repo}" && git ls-files -z --cached --others --exclude-standard |
    COPYFILE_DISABLE=1 /usr/bin/tar --no-mac-metadata --null -T - -cf -) |
    vm_ssh 'set -e
            rm -rf dojo.new && mkdir dojo.new
            tar -x -C dojo.new 2>/dev/null
            [ -f dojo.new/Cargo.toml ] || { echo "builder: the tree did not arrive" >&2; exit 1; }
            if [ -d dojo/target ]; then mv dojo/target dojo.new/; fi
            if [ -d dojo ]; then chmod -R u+w dojo; rm -rf dojo; fi
            mv dojo.new dojo'
}

# Builds the payload and copies it to support/vm/out; with --update-lock, copies
# Cargo.lock back too.
payload() {
  vm_ssh "dojo/support/vm/guest/build.sh dojo out ${1-}"
  mkdir -p "${here}/out"
  scp -q -F "${state}/ssh_config" dojo-builder:out/payload.cpio.gz "${here}/out/payload.cpio.gz"
  if [[ "${1-}" == --update-lock ]]; then
    scp -q -F "${state}/ssh_config" dojo-builder:dojo/Cargo.lock "${repo}/Cargo.lock"
  fi
  echo "builder: ${here}/out/payload.cpio.gz" >&2
}

# Copies the VM's Cargo.lock over the tree's if a command changed it.
fetch_lock() {
  local lock
  lock="$(mktemp)"
  scp -q -F "${state}/ssh_config" dojo-builder:dojo/Cargo.lock "${lock}"
  if ! cmp -s "${lock}" "${repo}/Cargo.lock"; then
    cp "${lock}" "${repo}/Cargo.lock"
    echo "builder: Cargo.lock changed in the VM; copied it back" >&2
  fi
  rm -f "${lock}"
}

# Deletes a tree's VM state, the disk with it. A running VM may be another
# session's build, so it stays unless the caller says to stop it.
discard() {
  local name=$1 stop_it=$2
  [[ -n "${name}" && "${name}" != */* && "${name}" != .* ]] || {
    echo "builder: not a tree name: ${name}" >&2
    exit 2
  }
  state="$(tree_state "${name}")"
  if [[ ! -d "${state}" ]]; then
    return 0
  fi
  if running; then
    if [[ -z "${stop_it}" ]]; then
      echo "builder: the VM for ${name} is running (pid $(cat "${state}/pid")); stop it first, or pass --stop" >&2
      exit 1
    fi
    stop
  fi
  rm -rf -- "${state}"
  echo "builder: discarded ${state}" >&2
}

case "${1-}" in
discard)
  case "$#:${3-}" in
  2:) discard "$2" "" ;;
  3:--stop) discard "$2" yes ;;
  *) usage ;;
  esac
  ;;
start)
  [[ $# -eq 1 ]] || usage
  start
  ;;
stop)
  [[ $# -eq 1 ]] || usage
  stop
  ;;
ssh)
  require_running
  shift
  exec ssh -F "${state}/ssh_config" -t dojo-builder "$@"
  ;;
payload)
  [[ $# -le 2 ]] || usage
  case "${2-}" in
  "" | --update-lock) ;;
  *) usage ;;
  esac
  require_running
  sync_tree
  payload "${2-}"
  ;;
test)
  [[ $# -ge 2 ]] || usage
  require_running
  shift
  sync_tree
  vm_ssh dojo/support/vm/guest/test.sh dojo "$@"
  ;;
run)
  [[ $# -ge 2 ]] || usage
  require_running
  shift
  sync_tree
  status=0
  # env.sh's run() puts cargo and the C libraries on the path; a bare cargo
  # exits 127. The command's words are quoted for the VM's shell.
  vm_ssh "cd dojo && . support/vm/guest/env.sh >&2 && run $(printf '%q ' "$@")" || status=$?
  fetch_lock
  exit "${status}"
  ;;
fmt)
  [[ $# -ge 2 ]] || usage
  require_running
  shift
  sync_tree
  packages=()
  for p in "$@"; do
    packages+=(-p "$p")
  done
  # rustfmt writes only the files it changes; those, newer than the stamp,
  # come back as a tar on stdout, so everything else goes to stderr.
  vm_ssh "cd dojo && . support/vm/guest/env.sh >&2 && stamp=\$(mktemp) &&
            run env PATH=\"\${rustfmt_nightly}/bin:\${PATH}\" cargo-fmt fmt $(printf '%q ' "${packages[@]}") >&2 &&
            find . -path ./target -prune -o -name '*.rs' -newer \"\${stamp}\" -print0 |
              tar --null -T - -cf - && rm -f \"\${stamp}\"" |
    /usr/bin/tar -xvf - -C "${repo}"
  ;;
verify)
  [[ $# -eq 1 ]] || usage
  require_running
  sync_tree
  status=0
  vm_ssh "dojo/support/vm/guest/verify.sh dojo verify-logs" || status=1
  payload || status=1
  for check in --check --check-reboot; do
    log="${here}/out/boot${check}.log"
    if "${here}/boot" "${check}" --payload "${here}/out/payload.cpio.gz" >"${log}" 2>&1; then
      echo "builder: boot ${check} passed" >&2
    else
      echo "builder: boot ${check} FAILED; see ${log}" >&2
      status=1
    fi
  done
  exit "${status}"
  ;;
*) usage ;;
esac
