#
# Discards the removed tree's builder VM state (support/vm/builder), so a tree's
# 16 to 27 GB disk goes with it. A VM still running may be in the middle of
# another session's build, so it refuses the removal then, unless --force was
# given, which stops that VM first.
#
# trees runs this from the main checkout, and so the main checkout's builder,
# which names a tree's state the same way for any tree, old ones included.

set -euo pipefail

flags=()
if [[ -n "${TREES_FORCE:-}" ]]; then
  flags+=(--stop)
fi
exec "${WORKTREE_REPO}/support/vm/builder" discard "${WORKTREE_NAME}" "${flags[@]}"
